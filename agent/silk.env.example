# agent silk: the staking agent. copy to silk.env next to it, fill in, and
# keep silk.env out of git and readable only by you (chmod 600).

# the agent's own key: the address registered on the switch as agent 27.
# never the cold key. never pasted anywhere else.
SILK_AGENT_KEY=

# the validator to stake with, as its numeric id on monad testnet. 91 is silk nodes.
# find it with: node silk.mjs validators <the validator's auth address>
VALIDATOR_ID=91

# optional
# MONAD_RPC=               defaults to the public monad testnet rpc
# ACT_SECONDS=21600        how often run compounds, default six hours
# MIN_COMPOUND_MON=0.01    rewards under this are left to grow
