# every value is empty on purpose. a real address, key or path never belongs in
# a repository, and nothing in this codebase falls back to a plausible default:
# a missing variable is logged by name and the service degrades visibly.

# ---- deploying the site -------------------------------------------------
# the host the site is deployed to, as user@host. never commit the real value.
DEPLOY_HOST=
# where trustset is checked out on that machine
DEPLOY_PATH=
# the public site, used only to verify a deploy landed
DEPLOY_SITE=https://trustset.silknodes.io

# ---- chain --------------------------------------------------------------
# defaults to the public monad testnet endpoint when unset
MONAD_RPC=
# "testnet" or "mainnet", shown in the site header
NEXT_PUBLIC_CHAIN=
# the erc-8004 identity registry, if you are pointing at a different one
ERC8004_REGISTRY=

# ---- the refund keeper (keeper/) ----------------------------------------
# signs refund(id) and nothing else. generate it on the machine that runs the
# keeper, mode 600, and keep it outside the checkout.
KEEPER_KEY=
# where the keeper remembers the lowest still-open payment id
KEEPER_STATE=
TRUSTSET_ROOT=
# seconds between sweeps. reading is free, so this can be low.
SWEEP_SECONDS=

# ---- the live agent (agent/) --------------------------------------------
# the agent's own hot key. generated on the machine, never on a laptop.
AGENT_KEY=
# the agent id the site's live panel reads
LIVE_AGENT_ID=
# the file the agent rewrites with what the switch told it. required: the
# panel has nothing to show without it and will say so rather than guess.
AGENT_STATE=
CHECK_SECONDS=
ACT_SECONDS=
# a Dynamic server wallet instead of AGENT_KEY. all five or none: with some but
# not all set the agent refuses to start and names what is missing. the token
# needs only the "WaaS Authenticate" scope. see agent/dynamic-setup.mjs.
DYNAMIC_ENVIRONMENT_ID=
DYNAMIC_API_TOKEN=
DYNAMIC_WALLET_PASSWORD=
DYNAMIC_AGENT_ADDRESS=
# the wallet's metadata as Dynamic returned it at creation. not secret, but the
# only way to sign with the wallet again: keep it.
DYNAMIC_WALLET_FILE=

# ---- the demo walkthrough (web/) ----------------------------------------
# pays gas so a judge with an empty wallet can finish /demo. testnet only.
DEMO_PAYER_KEY=
# where the demo remembers which agent belongs to which visitor
DEMO_STORE=
# guards the write endpoints on a public domain. fails closed when unset.
OPERATOR_TOKEN=
# the web service also reads DYNAMIC_ENVIRONMENT_ID (above): set, the console
# offers email sign-in through a Dynamic embedded wallet; unset, it does not.
# where the one-time testnet gas drips for new email wallets are recorded
GAS_STORE=
# where a visitor's pause of the live agent is recorded, for its timer
PUBLIC_PAUSE_STORE=

# ---- the indexer (indexer/) ---------------------------------------------
DATABASE_URL=
# the block the contracts were deployed at, so a fresh index knows where to start
START_BLOCK=
DEPLOY_BLOCK=
